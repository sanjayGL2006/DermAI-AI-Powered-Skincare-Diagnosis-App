# Google AI Studio / Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Flask secret key (generate a strong random string)
FLASK_SECRET_KEY=your_very_secret_flask_key_here

# Environment
FLASK_ENV=development

# Firebase Admin SDK Service Account Key (optional, defaults to serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_KEY=serviceAccountKey.json
